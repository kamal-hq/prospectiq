# ==============================================================================
# Environment Configuration Template (.env.example)
# Lead Generation & Web Presence Validation Engine
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Replace the placeholder values with your actual API credentials.
# ==============================================================================

# SerpApi API Key (Required for live Google Maps / local business discovery)
# Free tier includes ~250 searches/month.
# Sign up & get your key at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# Brave Search API Key (Required for fallback search and web discovery)
# Free tier includes ~1,000 searches/month.
# Sign up & get your key at: https://api.search.brave.com/
BRAVE_API_KEY=your_brave_api_key_here

# Hunter.io API Key (Used for domain-level email search and verification fallback)
# Free tier includes ~50 searches/month.
# Sign up & get your key at: https://hunter.io/
HUNTER_API_KEY=your_hunter_api_key_here

