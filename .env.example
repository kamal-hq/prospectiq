# ==============================================================================
# Environment Configuration Template (.env.example)
# Lead Generation & Web Presence Validation Engine
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Replace the placeholder values with your actual API credentials.
# ==============================================================================

# SerpApi API Key (Required for live Google Maps / local business discovery)
# Free tier includes ~250 searches/month.
# Sign up & get your key at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# Brave Search API Key (Required for fallback search and web discovery)
# Free tier includes ~1,000 searches/month.
# Sign up & get your key at: https://api.search.brave.com/
BRAVE_API_KEY=your_brave_api_key_here

# Hunter.io API Key (Used for domain-level email search and verification fallback)
# Free tier includes ~50 searches/month.
# Sign up & get your key at: https://hunter.io/
HUNTER_API_KEY=your_hunter_api_key_here

# ==============================================================================
# Shared Supabase Multi-Schema Hub (`shared-apps`, isolated `prospectiq` schema)
# Co-hosted alongside sibling app `cadence` (Exposed schemas: public, cadence, prospectiq)
#
# CRITICAL SECURITY RULE (PUBLISHABLE KEY ONLY):
#   - Use ONLY the publishable key (`sb_publishable_...`) + Owner Auth sign-in.
#   - NEVER store Supabase's Secret / `service_role` key in `.env`, `.env.local`,
#     Vercel, or GitHub Secrets (it would bypass RLS across sibling schemas like `cadence`).
#   - On Vercel, add `NEXT_PUBLIC_*` env vars manually with Type = Config (NOT Secret).
#   - Optional for offline local SQLite CLI runs; required for cloud persistence & CI.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_SCHEMA=prospectiq

# Single-Owner credentials for headless Python / GitHub Actions worker JWT auth
# (If already registered on Cadence with the same email, reuse the same account!)
SUPABASE_OWNER_EMAIL=your_owner_email@example.com
SUPABASE_OWNER_PASSWORD=your_owner_password_here


